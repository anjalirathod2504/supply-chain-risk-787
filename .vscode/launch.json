{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run full analysis",
      "type": "debugpy", "request": "launch",
      "module": "scrisk.run_analysis",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "debugpy", "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
